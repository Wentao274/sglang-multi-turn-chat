# ===== 必填：服务地址与模型 =====
BASE_URL=http://127.0.0.1:30000
MODEL=glm-5.3
TOKENIZER=/path/to/tokenizer

# ===== 必填：API Key（需要鉴权时填写） =====
# 框架自动注入 OPENAI_API_KEY 环境变量，sglang 客户端用 Authorization: Bearer <key> 发送
API_KEY=

# ===== 必填：数据集路径 =====
DATASET_PATH=/path/to/ShareGPT_V3_unfiltered_cleaned_split.json

# ===== 可选：后端（默认 sglang-oai-chat） =====
# BACKEND=sglang-oai-chat
